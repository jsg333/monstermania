# The JS filename contains a content hash, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html must NEVER be cached, or players keep loading yesterday's game
# after a fix has already shipped. This bit us: bugs were fixed and deployed
# and the player still hit them on reload.
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
